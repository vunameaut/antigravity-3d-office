{
  "antigravity-3d-office": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node hook-reporter.js",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node hook-reporter.js",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "type": "command",
        "command": "node hook-reporter.js",
        "timeout": 5
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "command": "node hook-reporter.js",
        "timeout": 5
      }
    ]
  }
}

